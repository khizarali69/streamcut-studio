# StreamCut Studio Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Whisper Speech-to-Text
# Options: tiny.en (~75MB), base.en (~140MB), small.en (~460MB), medium (~1.5GB)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# FFmpeg Executables
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional External / Local LLM Analysis (Disabled by default)
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3
LLM_API_KEY=

# Storage Limits
MAX_UPLOAD_SIZE_MB=4096
